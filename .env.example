# Copie para .env.local (no computador) ou cadastre em Settings → Environment Variables (na Vercel).

# Senha do painel e segredo das sessões (um texto aleatório longo).
PAINEL_SENHA=
AUTH_SECRET=

# Banco: Supabase → Connect → Transaction pooler (porta 6543). Sem ela, usa um Postgres embutido em .data/ (só no computador).
DATABASE_URL=

# IA (console.anthropic.com → API Keys; começa com sk-ant-api03-).
ANTHROPIC_API_KEY=
# Opcional: outro modelo. Padrão: claude-opus-5-5.
ANTHROPIC_MODEL=

# WhatsApp pela Evolution API (Railway): endereço do serviço e a AUTHENTICATION_API_KEY dele.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Opcional: nome da conexão na Evolution (padrão agentes-ia). Use um nome diferente por cliente se vários usarem o mesmo servidor.
EVOLUTION_INSTANCE=

# Endereço público do sistema (usado no webhook do WhatsApp). Ex.: https://agentes-ia.vercel.app
APP_URL=

# Protege o /api/cron (os agentes automáticos). Use o mesmo valor no secret CRON_SECRET do GitHub Actions.
CRON_SECRET=
